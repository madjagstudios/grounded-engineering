{
  "name": "grounded-engineering",
  "version": "0.6.0",
  "description": "Source-backed engineering practices, adopted into AGENTS.md or CLAUDE.md through a proposal you review.",
  "type": "module",
  "bin": {
    "grounded-engineering": "bin/grounded-engineering.mjs"
  },
  "files": [
    "bin",
    "src",
    "packs",
    "practices",
    "policies"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "test": "npm run validate && node scripts/build-catalog.mjs --check && npm run test:unit",
    "test:unit": "node --test test/*.test.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:skill-repos": "node scripts/check-skill-repos.mjs",
    "scaffold:validation": "node scripts/scaffold-validation.mjs",
    "discover:skill-repos": "node scripts/discover-skill-repos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madjagstudios/grounded-engineering.git"
  },
  "homepage": "https://github.com/madjagstudios/grounded-engineering#readme",
  "bugs": {
    "url": "https://github.com/madjagstudios/grounded-engineering/issues"
  },
  "keywords": [
    "engineering-practices",
    "ai-assisted-development",
    "coding-agents",
    "coding-standards",
    "claude-code",
    "cli"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "spdx-expression-parse": "5.0.0",
    "yaml": "2.8.3"
  }
}
